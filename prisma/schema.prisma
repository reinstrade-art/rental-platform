// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Organization is the tenancy root. Every operational row below carries an
// organizationId and every query in app code MUST filter on the session's
// organizationId — there is no database-level isolation (shared schema),
// so isolation is an app-code invariant, not a schema one. See User.role
// comment for the one exception (PLATFORM_ADMIN has no organizationId).
// ---------------------------------------------------------------------------
model Organization {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED — a platform admin's own manual switch, independent of licensing below.

  // The platform's own licensing lifecycle for this customer — a second,
  // independent axis from `status` above. `status` is a platform admin's
  // manual override (e.g. a ToS violation); this is the billing state, and
  // getSession() blocks login on EITHER being unfavorable, never conflating
  // the two into one field. See app/lib/licensing.ts for the state machine.
  //
  // trialEndsAt is set once, at creation (createOrganization), to now + the
  // platform's trial window — never extended automatically. licenseExpiresAt
  // starts null and is pushed forward only by a recorded LicensePayment;
  // an org counts as licensed for as long as either date is still in the
  // future, so a trial customer who pays early doesn't lose days, and a paid
  // customer's trial window (already elapsed) is simply irrelevant.
  trialEndsAt      DateTime?
  licenseExpiresAt DateTime?
  // What this customer is actually being charged — set by a platform admin,
  // not a fixed platform-wide price, since real pricing varies by portfolio
  // size and by what was actually negotiated.
  licenseFeeKes    Float?

  // Which commercial package this customer is on — BASIC | INTERMEDIATE |
  // ADVANCED | FULL, ascending. Gates entire modules (see TIER_FEATURES in
  // app/lib/constants.ts and requireFeature in app/lib/tier.ts), independent
  // of the trial/license billing state above: a customer can be fully
  // licensed and still only see what their package includes. Set by a
  // platform admin from the org detail page, never chosen by the customer.
  tier String @default("BASIC")

  // Branding for tenant/tradesman-facing documents (receipts, invoices) and
  // portals. This system is white-label — nothing in app code names any one
  // customer's business; every value here is data one org entered about
  // itself, never a default baked into a template. brandColor is a hex
  // string (e.g. "#1E3350"); a generic neutral is used until an org sets one.
  letterheadName    String?
  letterheadAddress String?
  letterheadPhone   String?
  letterheadEmail   String?
  brandColor        String?

  // Free text the org writes itself and that prints into every tenancy
  // agreement PDF. Deliberately NOT a fixed set of legal clauses baked into
  // the platform — lease terms vary by jurisdiction and by landlord, and
  // drafting one universal tenancy agreement for arbitrary businesses isn't
  // something app code should attempt. Null renders as an explicit
  // placeholder rather than silently blank, so a lease is never generated
  // looking like it has no terms when really nobody has filled them in yet.
  leaseTermsTemplate String?

  // How many sequential signatures a raised approval needs before it takes
  // effect: 1 = the raiser's own signature is enough, 2 = raiser + someone
  // ranked MANAGER or above, 3 = raiser + MANAGER-or-above + DIRECTOR (the
  // reference implementation's fixed choice, kept as the default here but
  // made configurable per organization rather than hard-coded).
  approvalChainLength Int @default(3)

  // Daraja (M-Pesa) STK Push credentials for THIS organization's own
  // paybill/till — never a platform-wide shortcode. STK Push sidesteps the
  // "shared paybill" problem that blocked C2B auto-capture in the reference
  // build entirely: the app raises the prompt itself and correlates the
  // result by checkoutRequestId (an id it generated), so there is no
  // reference string to match against a possibly-ambiguous account number.
  // The real constraint this doesn't remove: an org still needs its OWN
  // Safaricom shortcode to configure this — nothing here works on a
  // paybill the org doesn't own. Stored as plain columns, same trust model
  // as the reference build's env vars; encrypting these at rest is a
  // reasonable later hardening pass, not done here.
  mpesaEnv            String? // "sandbox" | "production"
  // Which kind of shortcode mpesaShortcode actually is — changes only the
  // STK Push TransactionType sent to Safaricom (CustomerPayBillOnline vs
  // CustomerBuyGoodsOnline); everything else about the request is identical.
  // Null reads as PAYBILL, so every org configured before this field existed
  // keeps behaving exactly as before.
  mpesaAccountType    String? // "PAYBILL" | "TILL"
  mpesaShortcode      String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaPasskey        String?

  // The platform's own cut of this org's tenant rent payments. Null reads as
  // "use PlatformSetting's platform-wide default" — the same
  // default-plus-override shape as OrgTierPrice, just for a rate instead of
  // a price. Purely a ledger figure until commissionRouted (below) is on:
  // Payout rows get computed either way, but nothing is disbursed while
  // rent still lands in this org's own paybill.
  commissionPercent Float?
  // Where this org's share gets sent once commissionRouted is on — their own
  // M-Pesa number, set by the org's own ADMIN in Settings, never chosen by
  // the platform on their behalf.
  payoutMpesaNumber String?
  // Off by default, and only ever flipped on deliberately per org once B2C
  // payouts are confirmed working — see app/lib/mpesa.ts. While off, this
  // org's tenant rent STK Push still goes straight to its OWN shortcode
  // exactly as before; nothing about adding this field changes that.
  commissionRouted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  properties       Property[]
  tenants          Tenant[]
  leases           Lease[]
  charges          Charge[]
  payments         Payment[]
  paymentAllocations PaymentAllocation[]
  expenses         Expense[]
  vendors          Vendor[]
  suppliers        Supplier[]
  messages         Message[]
  repairs          Repair[]
  quotes           Quote[]
  approvalRequests ApprovalRequest[]
  invitations      Invitation[]
  transactions     Transaction[]
  auditLogs        AuditLog[]
  mpesaRequests    MpesaRequest[]
  evictions        Eviction[]
  licensePayments  LicensePayment[]
  tierChangeRequests TierChangeRequest[]
  orgTierPrices    OrgTierPrice[]
  recurringJobs    RecurringJob[]
  payouts          Payout[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  accountingConnections AccountingConnection[]
  accountingSyncLogs    AccountingSyncLog[]
  messageAttachments    MessageAttachment[]
}

// A landlord's own credential for pulling their org's data out through the
// read-only REST API (see app/api/v1) — accounting/ERP integration that
// doesn't wait on a person exporting a CSV by hand. The raw key is shown
// once, at creation, then only its SHA-256 hash is kept — same trust model
// as a password, since this grants read access to everything in the org
// scoped to it. keyPrefix (the key's first 8 chars) is stored in the clear
// purely so the list UI can show "which key is this" without ever
// re-displaying — or being able to re-derive — the secret itself.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  keyHash   String @unique
  keyPrefix String

  createdBy  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
}

// A single row (id "default") holding the platform-wide commission rate —
// same singleton-settings shape as TierPrice's list, but one number instead
// of one per tier, since there's only one thing to default here.
model PlatformSetting {
  id                String   @id @default("default")
  commissionPercent Float    @default(0)
  updatedAt         DateTime @updatedAt
}

// One row per tenant rent payment that was (or is being) split — created the
// moment a commission-routed org's payment lands, before the B2C transfer is
// even attempted, so a disbursement that never completes is still a visible
// PENDING row rather than money that silently vanished from the ledger.
model Payout {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  grossAmount      Float
  commissionAmount Float
  netAmount        Float

  status String @default("PENDING") // PENDING | SUCCESS | FAILED

  // Safaricom B2C's own two request ids (distinct from STK's
  // merchantRequestId/checkoutRequestId) — ConversationID is returned
  // immediately, OriginatorConversationID is the app's own idempotency key
  // sent on the request.
  conversationId           String?
  originatorConversationId String?
  resultCode               Int?
  resultDesc                String?
  mpesaReceiptNumber        String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  platformAccountingSyncLog PlatformAccountingSyncLog?

  @@index([organizationId])
}

// One row per license payment — whether recorded by hand (bank transfer,
// cash) or raised as an M-Pesa STK Push against the PLATFORM's own
// shortcode (never an org's own — this is the org paying the platform, the
// mirror image of Organization.mpesaShortcode which is the org collecting
// rent). Only a SUCCESS row ever extends Organization.licenseExpiresAt —
// see recordLicensePayment / the STK callback in app/lib/licensing.ts — so
// a failed or abandoned prompt can never be mistaken for a paid license.
model LicensePayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  amount     Float
  method     String // MPESA_STK | BANK | CASH | OTHER
  reference  String?
  periodDays Int    @default(30)

  status String @default("SUCCESS") // PENDING | SUCCESS | FAILED — PENDING only while an STK prompt is in flight

  merchantRequestId  String?
  checkoutRequestId  String? @unique
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?

  // Platform-admin userId who recorded this (or triggered the STK prompt).
  recordedBy String

  createdAt DateTime @default(now())

  platformAccountingSyncLog PlatformAccountingSyncLog?

  @@index([organizationId])
}

// The PLATFORM's own Wave connection — one row, id "default", the same
// singleton shape as PlatformSetting. Deliberately not another row on
// AccountingConnection: that table is an ORG's own customer accounting
// (their tenants' rent, their books); this is the operator's own books —
// license revenue coming in, commission payouts going out. A platform
// admin connects exactly one Wave business, once, from Platform Admin →
// Accounting, the same OAuth shape as the per-org QuickBooks connection in
// app/lib/quickbooks.ts.
model PlatformAccountingConnection {
  id       String @id @default("default")
  provider String @default("WAVE")

  accessToken  String
  refreshToken String
  expiresAt    DateTime

  // Wave's own id for the connected business — chosen at connect time from
  // whichever businesses the admin's Wave account belongs to.
  businessId String

  // Wave account ids the sync posts against, picked from that business's
  // own chart of accounts — never guessed, same reasoning as
  // AccountingConnection.incomeAccountId/bankAccountId.
  incomeAccountId  String? // credited by a LicensePayment
  expenseAccountId String? // debited by a Payout
  bankAccountId    String? // the anchor both sides move through

  connectedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per LicensePayment/Payout pushed to Wave — same "a failed sync is
// a visible FAILED row, never a silent gap" discipline as
// AccountingSyncLog, just platform-scoped and covering both directions of
// money instead of only incoming tenant payments.
model PlatformAccountingSyncLog {
  id String @id @default(cuid())

  kind String // LICENSE_PAYMENT | PAYOUT

  licensePaymentId String?         @unique
  licensePayment   LicensePayment? @relation(fields: [licensePaymentId], references: [id], onDelete: Cascade)
  payoutId         String?         @unique
  payout           Payout?         @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  provider   String  @default("WAVE")
  externalId String? // the Wave money-transaction id, once SUCCESS
  status     String  @default("PENDING") // PENDING | SUCCESS | FAILED
  error      String?
  syncedAt   DateTime?

  createdAt DateTime @default(now())
}

// What each package costs by default — the platform's standard price list.
// One row per tier; a tier with no row here simply has no price shown yet,
// rather than a guessed number. A specific customer negotiated to pay more
// (or less) isn't a change to this list — see OrgTierPrice below, which
// overrides this per organization without touching what everyone else pays.
model TierPrice {
  id       String @id @default(cuid())
  tier     String @unique // BASIC | INTERMEDIATE | ADVANCED | FULL
  priceKes Float

  updatedAt DateTime @updatedAt
}

// A negotiated price for one organization's upgrade to a specific tier —
// "this customer pays more/less than the standard list price." Looked up
// first when an org requests an upgrade; falls back to TierPrice when no
// override exists for that org+tier pair. Deleting the row (not zeroing the
// price) is how an admin clears an override back to the standard price.
model OrgTierPrice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tier     String // BASIC | INTERMEDIATE | ADVANCED | FULL
  priceKes Float

  updatedAt DateTime @updatedAt

  @@unique([organizationId, tier])
}

// A landlord's own request to move to a different package — self-served,
// unlike LicensePayment above which only a platform admin ever raises. An
// upgrade needs money to change hands first; a downgrade is free and applied
// immediately, but still recorded here (amount 0, method DOWNGRADE) so the
// tier's whole history reads from one table. Only a SUCCESS row ever changes
// Organization.tier — see app/lib/tier-requests.ts.
model TierChangeRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  fromTier String
  toTier   String
  amount   Float
  method   String // MPESA_STK | BANK | CASH | OTHER | DOWNGRADE
  reference String?

  status String @default("PENDING") // PENDING | SUCCESS | FAILED | REJECTED

  merchantRequestId  String?
  checkoutRequestId  String? @unique
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?

  // The org staff userId who made the request, and — for a manual
  // (non-M-Pesa) payment a platform admin had to confirm — who confirmed it.
  requestedBy String
  confirmedBy String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([organizationId])
}

// Roles:
//   PLATFORM_ADMIN                    — cross-org, organizationId is NULL
//   ADMIN, MANAGER, VIEWER            — staff, scoped to one organization
//   TENANT                            — outside role, resolves to one Tenant record
//   TRADESMAN, CASUAL_LABOURER        — outside role, resolves to one Vendor record
// Membership is allow-list based wherever it's checked in code — never "not X" —
// because that inversion was a real defect class in the reference build (HM Kariuki):
// a new outside role would otherwise silently inherit the whole operator app the
// moment it existed, just by not being "a tenant".
model User {
  id             String   @id @default(cuid())
  organizationId String? // null only for PLATFORM_ADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Globally unique (not scoped to organizationId): login is by email/phone
  // alone, before an organization is known, so two users sharing an email
  // across two different organizations is out of scope for Phase 1 — an
  // affected person just needs a second address. This also keeps PLATFORM_ADMIN
  // (organizationId null) collision-free, which a per-org unique constraint
  // would not, since SQLite treats each NULL as distinct.
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         String   // PLATFORM_ADMIN | ADMIN | MANAGER | VIEWER | CARETAKER | TENANT | TRADESMAN | CASUAL_LABOURER

  // Outside-role links: a session resolves to exactly one of these, never both.
  // getSession() kills the session if role and link disagree (e.g. role TENANT
  // but tenantId null, or role flipped to TRADESMAN while tenantId lingers).
  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  // Set only for CARETAKER — the single property they onboard tenants for.
  // Not unique: a property can have more than one caretaker.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  // Authority to sign an approval chain — a dimension separate from `role`.
  // Only staff (ADMIN/MANAGER/VIEWER) may hold a seat; a VIEWER could in
  // principle still be handed REQUESTER-level authority, but signing power
  // is granted here explicitly, never inferred from `role`.
  approvalLevel String? // REQUESTER | MANAGER | DIRECTOR | null

  // Access revoked without deleting the account (history — approvals signed,
  // repairs reported — stays attached to a real row). Checked on every
  // request in getSession(), same as an organization's own suspension.
  disabledAt DateTime?

  // Set when an admin hands this account a temporary password (see
  // resetStaffPasswordAction) — forces a stop at /change-password on the
  // next request before anything else in the app is reachable, same way
  // disabledAt blocks access outright. Cleared the moment a real password
  // is chosen.
  mustChangePassword Boolean @default(false)

  // Custom module access for a MANAGER/VIEWER, set by the org's own ADMIN —
  // a JSON array of module keys (see MODULE_LIST in app/lib/constants.ts),
  // e.g. ["properties","leases","payments"]. Null means "full access", the
  // default for every account until an admin deliberately narrows it —
  // required NOT ever meaning "no access", which would silently lock out
  // every existing MANAGER/VIEWER the moment this column shipped. Ignored
  // entirely for ADMIN, who always has full access regardless of this field.
  permissions String?

  // Recorded at registration for outside roles (TENANT/TRADESMAN/CASUAL_LABOURER).
  // consentVersion pins WHICH wording of the notice was agreed to — bump
  // CONSENT_VERSION in app/lib/consent.ts whenever the wording changes what
  // someone is agreeing to, since consent to an earlier notice is not
  // consent to a later one.
  consentedAt    DateTime?
  consentVersion String?

  createdAt DateTime @default(now())

  approvalStepsSigned ApprovalStep[]
  approvalsRaised     ApprovalRequest[]
  auditLogsWritten    AuditLog[]
  sessions            Session[]
  deviceTokens        DeviceToken[]
}

// One row per installed copy of the Android app that's asked to be notified —
// keyed on the FCM token itself (unique per install), not per user, so a
// second person signing in on the same phone reassigns the row to them
// rather than leaving the old owner's token stuck on it. A user can hold
// several (several phones, or a reinstall).
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  token    String @unique
  platform String @default("ANDROID")

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// One row per signed-in device, not per login — the JWT's jti points here, so
// revoking is deleting access a signature alone can no longer prove. Without
// this table a stolen or leaked token stays good until it expires on its own
// schedule; with it, "sign out this device" and "sign out everywhere" are
// both just a row update.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  // Set only when a staff member opened this session on somebody else's
  // behalf (impersonation) — never across organizations, never onto another
  // ADMIN. See app/lib/auth.ts `impersonate()`.
  impersonatedByUserId String?

  @@index([userId])
}

// Login-failure lockout, keyed on the identifier typed at sign-in (not the IP,
// so a lock can't be dodged by switching networks) and recorded even for
// unknown addresses, so a lock's presence never reveals which accounts exist.
model LoginAttempt {
  email       String    @id
  failedCount Int       @default(0)
  lastFailed  DateTime
  lockedUntil DateTime?
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name    String
  address String?

  units         Unit[]
  repairs       Repair[]
  expenses      Expense[]
  recurringJobs RecurringJob[]
  caretakers    User[]
  tenants       Tenant[]

  createdAt DateTime @default(now())
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  // Denormalized for cheap org-scoped queries without joining through Property.
  organizationId String

  label String // e.g. unit/house number
  monthlyRent Float?

  // The reference a payer types (e.g. a paybill account number, or the code
  // staff match a bank/M-Pesa narration against). Unique per organization,
  // not globally, so two different landlord customers can each choose "A1"
  // without colliding — there is no shared paybill to disambiguate them.
  paymentCode String?

  leases  Lease[]
  repairs Repair[]

  createdAt DateTime @default(now())

  @@unique([propertyId, label])
  @@unique([organizationId, paymentCode])
}

model Tenant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Set only when this tenant was onboarded by a caretaker (who works a
  // single property) and has no lease yet — it's what lets a caretaker's
  // tenant list stay scoped to their own property before there's a Lease to
  // scope by. Staff-onboarded tenants leave this null; once a lease exists,
  // the tenant's real property comes from lease -> unit -> property anyway.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  name  String
  phone String?
  email String?

  leases         Lease[]
  user           User?
  messages       Message[]
  reportedRepairs Repair[]

  createdAt DateTime @default(now())
}

// A conversation thread with one tenant, office and tenant both writing into
// the same list. fromTenant is the only thing that decides which side of the
// thread a line renders on; authorName is captured at write time so a
// disabled/removed staff account never blanks out who said what.
model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sanitized HTML (see app/lib/sanitize.ts) — every write path runs it
  // through the same allowlist before this column is touched, so anything
  // rendered from here via dangerouslySetInnerHTML is already safe; nothing
  // else ever writes to this table.
  body       String
  fromTenant Boolean @default(false)
  authorName String

  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([tenantId])
}

model Lease {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  monthlyRent Float
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | ENDED

  // E-signature: set once the tenant signs from their own portal login.
  // signatureImage is a data: URL (PNG) drawn on a canvas, not a typed name —
  // it embeds directly into the agreement PDF. signedIp/signedUserAgent are
  // captured at signing time as the closest thing this has to a witness.
  signatureImage  String?
  signedAt        DateTime?
  signedByName    String?
  signedIp        String?
  signedUserAgent String?

  charges  Charge[]
  payments Payment[]
  mpesaRequests MpesaRequest[]
  evictions     Eviction[]

  createdAt DateTime @default(now())
}

// Eviction under Kenyan law — grounds, the notice period the law sets, and a
// staged record of the process (notice → optional distress for rent → suit
// → court order → enforcement by a bailiff). There is deliberately no
// action anywhere in this app that ends a tenancy on its own from here: the
// system drafts the notice and tracks what stage a case is at, but a lawful
// eviction ends with a court order enforced by a court officer, never with
// software changing a lock. See app/lib/eviction.ts.
model Eviction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  // Comma-separated codes from ARREARS | BREACH_OF_COVENANT | NUISANCE_ILLEGAL |
  // WASTE_DAMAGE | LEASE_EXPIRY | LANDLORD_OCCUPATION — a tenant may be in
  // breach of more than one at once, and the notice must name only the ones
  // that actually apply to them, never the full list of what the law allows.
  grounds       String
  groundsDetail String?

  // NOTICE_DRAFT | NOTICE_SERVED | DISTRESS_FILED | COURT_FILED | ORDER_OBTAINED | VACATED | ENFORCED | WITHDRAWN
  status String @default("NOTICE_DRAFT")

  // Step 1 — Notice to Vacate. deadline is never less than 30 days after
  // servedAt for a monthly periodic tenancy, checked in code before the
  // record is written, not left to whoever is filling the form in that day.
  noticeServedAt       DateTime?
  noticeDeliveryMethod String? // HAND_DELIVERED | REGISTERED_POST
  noticeDeadline       DateTime?

  // Step 2 — Distress for Rent (Cap 293), optional, arrears cases only.
  distressFiledAt  DateTime?
  auctioneerName   String?
  proclamationEnds DateTime? // 14 days from the proclamation, before goods may be attached

  // Step 3 — Suit filed once the notice period has expired unmet.
  courtFiledAt DateTime?
  courtVenue   String? // RRT | MAGISTRATE | ELC
  caseNumber   String?

  // Step 4 — the court's own order. Nothing may be enforced without this.
  orderObtainedAt DateTime?
  orderVacateBy   DateTime?

  // Step 5 — carried out by a court officer, never by the landlord directly.
  // Restricted to organization admins in app code (see recordEnforced).
  enforcedAt    DateTime?
  bailiffName   String?
  policePresent Boolean   @default(false)

  // The tenant complies and leaves on their own — the most common way a case
  // actually ends, reachable from any open stage, not only after an order.
  vacatedAt DateTime?

  withdrawnAt     DateTime?
  withdrawnReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leaseId])
  @@index([status])
}

model Charge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  type        String // RENT | DEPOSIT | WATER | HYGIENE (UTILITY kept for older rows — see CHARGE_TYPE_LABEL)
  description String?
  amount      Float
  periodMonth DateTime // UTC month-start, matches HM Kariuki's convention

  createdAt DateTime @default(now())

  allocations PaymentAllocation[]
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  amount    Float
  method    String? // e.g. MPESA, CASH, BANK
  reference String?
  paidAt    DateTime

  createdAt DateTime @default(now())

  transaction Transaction?
  mpesaRequest MpesaRequest?
  payout      Payout?
  accountingSyncLogs AccountingSyncLog[]

  // How much of this one payment the office has said goes to which charge —
  // e.g. 4,000 of a 4,900 M-Pesa receipt is rent, 200 is water, 700 is
  // hygiene. Optional and additive: rows here are a fact the office recorded,
  // never a guess. Whatever isn't itemized (amount minus the sum of these)
  // still falls into the ordinary oldest-charge-first pool — see allocate()
  // in app/lib/settle.ts, which applies these first and pools the remainder.
  allocations PaymentAllocation[]

  // A reference (M-Pesa code, bank transaction id) identifies one real-world
  // transfer — recording it twice would be the same money counted twice.
  // Scoped per organization rather than globally: SQLite allows many NULLs
  // in a unique index, so cash payments and historical imports without a
  // reference are unaffected.
  @@unique([organizationId, reference])
}

// One line of a payment's breakdown — "1,200 of this payment is rent." A
// payment can have several of these (one per charge it covers) or none at
// all (an ordinary undirected lump sum). Deleting the payment or the charge
// it points at removes the allocation with it; neither can exist headless.
model PaymentAllocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  chargeId String
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  amount Float

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([chargeId])
}

// The landlord's own money going out — as distinct from Charge/Payment,
// which are the tenant's side of the ledger. Every expense that isn't posted
// automatically from a completed repair goes through the same approval
// chain as REPAIR_COST (see app/lib/approvals.ts PAYMENT_OUT case) — money
// leaving the business is a commitment and gets signed off, same standard
// this app already holds repair costs to.
model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  category    String // see EXPENSE_CATEGORIES in app/lib/constants.ts
  amount      Float
  paidAt      DateTime
  description String?
  payee       String?
  method      String?
  reference   String?

  // Set only when this entry was posted automatically from a completed
  // repair's final cost — @unique so re-posting the same repair corrects
  // the entry rather than paying for the same job twice.
  repairId String? @unique
  repair   Repair? @relation(fields: [repairId], references: [id])

  // userId of whoever raised the approval request this expense came from
  // (or who recorded it directly, for a repair auto-post).
  recordedBy String

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([propertyId])
}

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  trade       String? // e.g. plumbing, electrical
  contactName String?
  phone       String?
  email       String?

  // Nobody self-declares prequalified — an office decision, set here by staff,
  // never by a signup checkbox on any future vendor-facing portal.
  prequalified Boolean @default(false)
  notes        String?

  repairs       Repair[]
  quotes        Quote[]
  user          User?
  recurringJobs RecurringJob[]

  createdAt DateTime @default(now())
}

// Where materials for a repair were bought — a hardware shop, a builders'
// merchant, an electrical or plumbing supplier — distinct from Vendor, which
// is who is paid for labour. itemDescription/itemPrice are a quick
// reference so the office doesn't have to ring round to remember what
// something cost last time, not a catalogue.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name            String
  category        String  @default("GENERAL")
  itemDescription String?
  itemPrice       Float?
  contactName     String?
  phone           String?
  email           String?
  notes           String?

  repairs Repair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repair {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  // Nullable so common-area faults (not tied to one tenancy) are expressible.
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id])

  // Where this job's materials were bought, if anywhere — one supplier per
  // job for now; a job drawing on several can name the main one and note
  // the rest in `description`.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  title       String
  description String?
  category    String? // e.g. plumbing, electrical, structural
  priority    String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String  @default("REPORTED") // REPORTED | QUOTING | APPROVED | IN_PROGRESS | DONE | CANCELLED

  // Set when a tenant filed this themselves from their portal rather than
  // staff logging it directly — lets the tenant see their own request's
  // progress, and lets staff see at a glance which jobs came in that way.
  // Null for anything staff-created, including common-area faults with no
  // tenant to attribute it to.
  reportedByTenantId String?
  reportedByTenant   Tenant? @relation(fields: [reportedByTenantId], references: [id])

  reportedAt  DateTime @default(now())
  completedAt DateTime?

  awardedVendorId String?
  awardedVendor   Vendor? @relation(fields: [awardedVendorId], references: [id])
  workOrderSentAt DateTime?
  workOrderRef    String?

  // Two separate gates, deliberately: authorising the WORK to proceed is a
  // different decision from authorising its PRICE. Phase-1 records who
  // approved directly; a later phase routes both through a multi-signature
  // approval chain without changing these fields' meaning.
  workApprovedAt DateTime?
  workApprovedBy String?
  costApprovedAt DateTime?
  costApprovedBy String?
  approvedCost   Float?

  // The landlord's actual expense — not a tenant Charge unless explicitly
  // recharged (out of scope for Phase 1's repairs module).
  finalCost Float?

  quotes  Quote[]
  // Set once this repair's finalCost is posted to the expense ledger — see
  // postRepairExpense in app/lib/expenses.ts. @unique so re-posting the same
  // repair corrects its one entry rather than duplicating the cost.
  expense Expense?

  createdAt DateTime @default(now())
}

// A vendor job whose frequency and cost are already known — cleaning being
// the first of these — so it doesn't need reporting, quoting or approving
// every time it falls due. The daily cron (app/api/cron/daily) creates it
// as an already-DONE Repair at nextDueAt, posts its cost to Expenses via the
// same postRepairExpense path a human-completed repair uses, and advances
// nextDueAt by frequencyDays — no approval loop, since the cost was already
// agreed when the job was set up.
model RecurringJob {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])

  title         String
  category      String @default("CLEANING")
  cost          Float
  frequencyDays Int    @default(30)
  nextDueAt     DateTime
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([nextDueAt])
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  repairId String
  repair   Repair @relation(fields: [repairId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  amount Float
  notes  String?
  status String @default("SUBMITTED") // SUBMITTED | ACCEPTED | REJECTED

  createdAt DateTime @default(now())

  @@unique([repairId, vendorId])
}

// A multi-signature approval chain. The person who raises a request supplies
// its first signature automatically (the "REQUESTER" slot); the remaining
// slots require someone ranked MANAGER or DIRECTOR, per the organization's
// approvalChainLength. Nothing the request governs takes effect until the
// chain completes — see app/lib/approvals.ts, the single place that decides
// who may sign and what happens when the last signature lands.
model ApprovalRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // What this request governs, and which row it acts on once approved.
  kind      String // REPAIR_WORK | REPAIR_COST | QUOTE_AWARD
  subjectId String
  // JSON-encoded extra data the final step needs (e.g. {"approvedCost":3500}).
  payload   String?

  status     String    @default("PENDING") // PENDING | APPROVED
  raisedById String
  raisedBy   User      @relation(fields: [raisedById], references: [id])
  raisedAt   DateTime  @default(now())
  resolvedAt DateTime?

  steps ApprovalStep[]

  // Only one open request per subject+kind — raising a second while one is
  // already pending would let two chains race to apply the same change.
  @@unique([organizationId, kind, subjectId, status])
}

// Append-only: a step is never edited or deleted, so the chain's history is
// exactly what happened, including any OVERRIDDEN stand-in signatures.
model ApprovalStep {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  level  String // REQUESTER | MANAGER | DIRECTOR — the slot this step filled
  // OVERRIDDEN records that no distinct eligible signer remained, so someone
  // of sufficient rank signed a second time for this request — visibly
  // different from a normal APPROVED step, never disguised as one.
  action String // APPROVED | OVERRIDDEN

  signedAt DateTime @default(now())
}

// Registration is closed: the only way into TENANT/TRADESMAN/CASUAL_LABOURER
// is a code issued here by staff against an existing Tenant or Vendor record,
// so a login always attaches to the record the office already created —
// never a duplicate, never self-declared. Invite/already-used/wrong-code all
// read alike at redemption time so the form can't be used to probe who has
// been invited.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  role String // MANAGER | VIEWER | CARETAKER | TENANT | TRADESMAN | CASUAL_LABOURER

  // Set only for TENANT/TRADESMAN/CASUAL_LABOURER — a staff invite (MANAGER
  // or VIEWER) attaches to no pre-existing record, since staff aren't
  // Tenant/Vendor rows. Never ADMIN: the one bootstrap admin per org comes
  // from platform-admin provisioning, not this flow — least-privilege by
  // construction, not by convention (an office invites help at VIEWER by
  // default and the admin explicitly promotes, rather than the other way
  // round).
  tenantId String?
  vendorId String?
  // Set only for CARETAKER — which property they're being onboarded to caretake.
  propertyId String?

  // The address/number this invite was issued to — redemption must match it,
  // so a code leaked to the wrong person can't attach to someone else's record.
  email String?
  phone String?

  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

// The single entry point for money arriving from ANY source — a manual note
// from a bank SMS, a bulk CSV/bank-statement import, or a live paybill
// webhook. HM Kariuki's own M-Pesa integration was blocked because its
// ingestion path assumed one owned paybill; every source here lands in this
// same table and goes through the same matching pass (app/lib/payments.ts),
// so adding a real Daraja/bank feed later is a new `source` value, not a
// redesign. Each organization may have zero, one, or several sources active
// independently of the others.
model Transaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  source String // MANUAL | CSV_IMPORT | MPESA_DARAJA
  amount Float
  // How the money actually moved — MPESA | CASH | BANK | CARD | CHEQUE (see
  // PAYMENT_METHODS in constants.ts). Distinct from `source` above, which is
  // how *this app* learned about the transaction (a webhook vs. a human
  // typing it in) -- a bank transfer entered manually has source MANUAL and
  // method BANK, not the other way round. Optional and defaults to null for
  // M-Pesa sources, whose method is already implied by `source` itself (see
  // matchTransaction in payments.ts) and for rows written before this
  // column existed.
  method String?
  // Whatever the source called it — a paybill account number, a bank
  // narration, an M-Pesa code — matched against Unit.paymentCode.
  reference   String?
  payerName   String?
  occurredAt  DateTime
  // The source's own payload, kept verbatim for audit/debugging — never
  // parsed twice differently in two different places.
  rawPayload  String?

  status String @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED

  matchedLeaseId   String?
  matchedPaymentId String?  @unique
  matchedPayment   Payment? @relation(fields: [matchedPaymentId], references: [id])
  matchedBy        String? // userId, null when matched automatically
  matchedAt        DateTime?

  createdAt DateTime @default(now())
}

// Every time a platform administrator looks into or acts on a specific
// organization's data, a row lands here — append-only, never edited or
// deleted, and never writable by that organization's own staff. This is the
// accountability half of "platform admins can see across organizations for
// support": the access itself is unavoidably visible, on the same footing
// as the org's own change history, not a silent side-channel.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  platformAdminId String
  platformAdmin   User   @relation(fields: [platformAdminId], references: [id])

  action String // VIEW_ORG_DETAIL | SUSPEND_ORG | REACTIVATE_ORG
  detail String?

  createdAt DateTime @default(now())
}

// One row per STK Push prompt raised. checkoutRequestId is what Safaricom's
// callback carries back — it is generated by this app when the prompt is
// sent, so the callback route can match it without trusting anything else
// in the request. That certainty is why a successful callback creates the
// Payment directly (via matchTransaction under the hood) rather than
// landing in the Transaction ledger's UNMATCHED queue: unlike a bank
// statement line or a C2B narration, there is no ambiguity to resolve.
model MpesaRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  phone  String
  amount Float
  status String @default("PENDING") // PENDING | SUCCESS | FAILED

  merchantRequestId  String?
  checkoutRequestId  String? @unique
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?

  initiatedBy String // STAFF | TENANT

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A landlord's own endpoint for real-time push -- the app POSTs an event the
// moment it happens (payment.recorded, lease.signed) instead of the org
// having to poll the REST API or wait for a CSV export. secret signs every
// delivery (HMAC-SHA256 over the raw body, in an X-Webhook-Signature
// header) so the receiving end can tell a real delivery from anyone who
// found the URL. lastTriggeredAt/lastStatus are the only "did this work"
// signal shown in the UI -- there is no retry queue; a failed delivery is
// simply not retried, which is why they're visible rather than hidden.
model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  url    String
  secret String

  createdBy       String
  lastTriggeredAt DateTime?
  lastStatus      Int?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
}

// A landlord's own QuickBooks (or eventually Xero) company, connected via
// OAuth2 -- accessToken/refreshToken are Intuit's, refreshed automatically
// as they near expiry (see app/lib/quickbooks.ts). One row per org per
// provider: @@unique([organizationId, provider]) rather than a single
// connection field, since Xero support is meant to slot in as a second
// provider row without touching this shape. incomeAccountId/bankAccountId
// are QuickBooks account IDs the org enters after connecting -- there is no
// way to guess which of a company's own chart-of-accounts entries should
// receive rent income, so this app never tries to.
model AccountingConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  provider String // QUICKBOOKS | XERO

  accessToken  String
  refreshToken String
  expiresAt    DateTime

  // QuickBooks calls this the realmId (the company's own id); Xero calls
  // the equivalent a tenantId -- kept as one column since exactly one
  // applies per row, selected by `provider`.
  realmId String

  incomeAccountId String?
  bankAccountId   String?

  connectedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, provider])
}

// One row per payment that was (or is being) pushed to a connected
// accounting system -- same "visible ledger row before the fact" discipline
// as Payout, so a sync that fails is a FAILED row a landlord can see and
// retry, never a payment that silently never made it into their books.
model AccountingSyncLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider   String // QUICKBOOKS | XERO
  externalId String? // the JournalEntry id QuickBooks/Xero assigned, once SUCCESS
  status     String  @default("PENDING") // PENDING | SUCCESS | FAILED
  error      String?
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([paymentId, provider])
}

// A file (image, PDF, or document) attached to one Message -- stored in
// Vercel Blob under a private, unguessable pathname; served only through
// app/api/attachments/[id], which re-checks the requester actually has
// access to this message's thread (staff/caretaker-in-scope/the tenant
// themselves) before streaming it, rather than relying on the blob URL's
// obscurity alone.
model MessageAttachment {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pathname String
  filename String
  mimeType String
  size     Int

  createdAt DateTime @default(now())

  @@index([messageId])
}
