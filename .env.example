# Local development (SQLite file) — this is what .env should contain locally.
# DATABASE_URL="file:./dev.db"

# Production (hosted Turso/libsql) — set these in Vercel's project env vars,
# not in a committed file. Get them from the Turso dashboard: Database →
# libsql URL, and Tokens → create token.
# DATABASE_URL="libsql://<your-db>-<your-username>.<region>.turso.io"
# DATABASE_AUTH_TOKEN="<token from Turso dashboard>"

# Signs session cookies. Required in production (the app throws without it);
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET="<random 32+ byte hex string>"
